{
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "my-bucket",
    "UseSsl": false
  },
  "FileValidation": {
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".pdf", ".txt"],
    "MaxFileSizeMb": 10
